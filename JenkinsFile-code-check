pipeline {
    agent any

    tools {
        nodejs 'NodeJS_22'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        ansiColor('xterm')
    }

    stages {
        stage('Checkout') {
            steps {
                // Multibranch handles SCM automatically
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "Installing npm dependencies..."
                sh 'npm ci'
            }
        }

        stage('Code Quality - ESLint') {
            steps {
                echo "Running ESLint static analysis..."
                sh 'npx eslint . --ext .js,.ts -f junit -o eslint-report.xml || true'
            }
            post {
                always {
                    recordIssues tool: eslint(pattern: '**/eslint-report.xml'),
                                 qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
                }
            }
        }

        stage('Post PR Checklist') {
            when {
                expression { env.CHANGE_ID != null }  // Only runs on PRs
            }
            steps {
                echo "Posting checklist to GitHub PR..."
                githubNotify context: 'PR Checklist', description: '''
### ✅ PR Checklist

- [ ] All PR feedback addressed  
- [ ] Tests are passing locally  
- [ ] All code guidelines are followed
''', status: 'SUCCESS'
            }
        }
    }

    post {
        success {
            githubNotify context: 'ESLint Check',
                         description: '✅ ESLint checks passed',
                         status: 'SUCCESS'
            echo "✅ Build successful"
        }
        unstable {
            githubNotify context: 'ESLint Check',
                         description: '⚠️ ESLint warnings found',
                         status: 'UNSTABLE'
            echo "⚠️ Build unstable due to ESLint warnings"
        }
        failure {
            githubNotify context: 'ESLint Check',
                         description: '❌ Build failed',
                         status: 'FAILURE'
            echo "❌ Build failed"
        }
    }
}